# Maintainer: Illegal Studio <hello@illegalstudio.it>
# Generated by scripts/gen-pkgbuild.sh for each release; do not edit on the AUR.
pkgname=linkctl-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Native Linux command-line control for Insta360 Link webcams (binary release)"
arch=('x86_64' 'aarch64')
url="https://github.com/illegalstudio/linkctl"
license=('MIT')
optdepends=('ffmpeg: linkctl preview'
            'mpv: linkctl preview --player mpv')
options=('!debug')
provides=('linkctl')
conflicts=('linkctl')
source_x86_64=("linkctl_${pkgver}_linux_amd64.tar.gz::@SOURCE_BASE@/linkctl_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("linkctl_${pkgver}_linux_arm64.tar.gz::@SOURCE_BASE@/linkctl_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('@SHA256_AMD64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  install -Dm755 "$srcdir/linkctl" "$pkgdir/usr/bin/linkctl"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  # Documentation only; enable it yourself if your system needs it.
  install -Dm644 "$srcdir/contrib/99-insta360-link.rules" \
    "$pkgdir/usr/share/doc/$pkgname/99-insta360-link.rules"
}
